# Public browser configuration (Supabase dashboard → Project Settings → API).
# Use a publishable key, or the legacy anon key. NEVER use a service-role/secret key.
# Development/test builds may use a local Supabase API.
# Production builds and startup require a hosted project API URL and public key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_ANON_KEY=  # optional legacy alternative

# Server-only Cloudflare vision configuration. Use an account-scoped Workers AI token.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_VISION_MODEL=@cf/mistralai/mistral-small-3.1-24b-instruct
# Eligible accounts may explicitly choose @cf/meta/llama-3.2-11b-vision-instruct.
# The app never accepts Meta terms or switches models automatically after a failure.

# Optional OpenAI backup; a key alone does not enable it.
AI_ENABLE_OPENAI_FALLBACK=false
# NEVER put these values in VITE_* variables or client code.
OPENAI_API_KEY=
# Optional backend-only alias for managed secret bindings that reserve OPENAI_*.
BASHASHIFT_OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# NODE_ENV=development
# Local development only; Render supplies PORT automatically.
PORT=8787

# Optional backend-only driving routes; missing key keeps manual distance available.
HEIGIT_API_KEY=
