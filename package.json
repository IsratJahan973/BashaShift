{
  "name": "bashashift-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"node server/index.mjs\"",
    "build": "vite build",
    "start": "node server/index.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "db:start": "supabase start",
    "db:reset": "supabase db reset --local",
    "db:env": "node scripts/local-supabase.mjs env",
    "test:integration": "node scripts/local-supabase.mjs test",
    "test:browser:live": "node scripts/local-supabase.mjs browser",
    "test:browser:auth-ui": "node scripts/test-auth-ui.mjs",
    "test:browser:ai": "node scripts/test-ai-browser.mjs",
    "test:browser:routes": "node scripts/test-ai-browser.mjs --routes-only"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "leaflet": "1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "0.35.5",
    "undici": "7.30.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
